  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single hazard action in a group, e.g. Back to the streets.",
      "html": "<button class=\"ds-btn-primary\"><svg class=\"ds-ic\" viewBox=\"0 0 24 24\"><path d=\"M7 4.5v15l12-7.5z\" fill=\"currentColor\"/></svg>Back to the streets</button>",
      "css": ".ds-btn-primary{height:50px;padding:0 22px;border:0;border-radius:10px;background:#ffd400;color:#14130f;font:700 19px/1 'Barlow Condensed','Arial Narrow',sans-serif;letter-spacing:.05em;text-transform:uppercase;display:inline-flex;align-items:center;gap:10px;cursor:pointer}.ds-btn-primary:hover{background:#ffe14d}.ds-btn-primary:focus-visible{outline:3px solid #ffd400;outline-offset:3px}.ds-ic{width:20px;height:20px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary actions on box black.",
      "html": "<div class=\"ds-black\"><button class=\"ds-btn-ghost\">Restart city</button></div>",
      "css": ".ds-black{background:#0d0d0c;padding:16px}.ds-btn-ghost{height:50px;padding:0 22px;border:0;border-radius:10px;background:none;color:#eef0f2;box-shadow:inset 0 0 0 2px #7d8188;font:700 19px/1 'Barlow Condensed','Arial Narrow',sans-serif;letter-spacing:.05em;text-transform:uppercase;cursor:pointer}.ds-btn-ghost:hover{box-shadow:inset 0 0 0 2px #eef0f2}.ds-btn-ghost:focus-visible{outline:3px solid #ffd400;outline-offset:3px}"
    },
    {
      "name": "PLAY Price Sticker",
      "kind": "custom",
      "refersTo": "sticker-play",
      "description": "The starburst price sticker that starts the game.",
      "html": "<div class=\"ds-black\"><button class=\"ds-play\"><svg viewBox=\"0 0 100 100\"><polygon points=\"50,0 57.6,6.7 67.1,3 72,11.9 82.1,11.7 83.7,21.7 93.3,25 91.3,35 99.2,41.3 94,50 99.2,58.7 91.3,65 93.3,75 83.7,78.3 82.1,88.3 72,88.1 67.1,97 57.6,93.3 50,100 42.4,93.3 32.9,97 28,88.1 17.9,88.3 16.3,78.3 6.7,75 8.7,65 0.8,58.7 6,50 0.8,41.3 8.7,35 6.7,25 16.3,21.7 17.9,11.7 28,11.9 32.9,3 42.4,6.7\"/></svg><span><b>PLAY</b><small>PRESS ENTER</small></span></button></div>",
      "css": ".ds-black{background:#0d0d0c;padding:24px}.ds-play{position:relative;width:168px;height:168px;border:0;background:none;cursor:pointer;transform:rotate(8deg);transition:transform .25s cubic-bezier(.16,1,.3,1);filter:drop-shadow(0 8px 12px rgba(0,0,0,.5))}.ds-play svg{position:absolute;inset:0;width:100%;height:100%}.ds-play polygon{fill:#ffd400;stroke:#14130f;stroke-width:1.5}.ds-play span{position:relative;display:grid;place-content:center;height:100%;color:#14130f;line-height:.95}.ds-play b{font:italic 900 40px 'Archivo','Arial Narrow',sans-serif;font-stretch:120%;letter-spacing:-.02em}.ds-play small{font:700 15px 'Barlow Condensed',sans-serif;letter-spacing:.06em;margin-top:4px}.ds-play:hover{transform:rotate(2deg) scale(1.05)}.ds-play:active{transform:rotate(4deg) scale(.96)}.ds-play:focus-visible{outline:none}.ds-play:focus-visible polygon{stroke-width:4}"
    },
    {
      "name": "Score Sticker",
      "kind": "custom",
      "refersTo": "sticker-score",
      "description": "Cash total with the multiplier roundel, top-right of the HUD.",
      "html": "<div class=\"ds-score\"><span class=\"ds-cash\">$0,012,450</span><span class=\"ds-mult\">×3</span></div>",
      "css": ".ds-score{display:inline-flex;align-items:center;gap:10px;background:#ffd400;color:#14130f;border:2px solid #14130f;border-radius:10px;padding:3px 7px 3px 13px;box-shadow:0 6px 16px rgba(20,19,15,.3);transform:rotate(.8deg)}.ds-cash{font:700 32px/1.05 'Barlow Condensed',sans-serif;letter-spacing:.01em;font-variant-numeric:tabular-nums}.ds-mult{min-width:38px;height:38px;border-radius:50%;background:#14130f;color:#ffd400;display:grid;place-items:center;font:italic 900 17px 'Archivo',sans-serif}"
    },
    {
      "name": "Status Sticker",
      "kind": "card",
      "refersTo": "sticker-status",
      "description": "Health and armor meters, heat label, on map paper with an ink border.",
      "html": "<div class=\"ds-status\"><div class=\"ds-row\"><div class=\"ds-meter\" style=\"width:118px\"><i style=\"width:70%;background:#d23a2a\"></i></div><div class=\"ds-meter\" style=\"width:58px\"><i style=\"width:40%;background:#5a8fd6\"></i></div></div><div class=\"ds-row\"><span class=\"ds-lbl\">Heat</span></div></div>",
      "css": ".ds-status{display:inline-grid;gap:7px;background:#ece6d2;color:#14130f;border:2px solid #14130f;border-radius:12px;padding:9px 12px 7px;box-shadow:0 6px 16px rgba(20,19,15,.3);transform:rotate(-.6deg)}.ds-row{display:flex;gap:8px;align-items:center}.ds-meter{position:relative;height:10px;border-radius:3px;background:#cbc1a3;overflow:hidden;box-shadow:inset 0 0 0 1.5px #14130f}.ds-meter i{display:block;height:100%}.ds-meter::after{content:'';position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 10px,#ece6d2 10px 12px)}.ds-lbl{font:700 13px 'Barlow Condensed',sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#4a453a}"
    },
    {
      "name": "HUD Button",
      "kind": "button",
      "refersTo": "hud-button",
      "description": "Square paper sticker button (pause, sound).",
      "html": "<button class=\"ds-hudbtn\" aria-label=\"Pause\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 4.5h4.2v15H6zM13.8 4.5H18v15h-4.2z\" fill=\"currentColor\"/></svg></button>",
      "css": ".ds-hudbtn{width:42px;height:42px;border-radius:10px;background:#ece6d2;color:#14130f;border:2px solid #14130f;display:grid;place-items:center;box-shadow:0 6px 16px rgba(20,19,15,.3);cursor:pointer}.ds-hudbtn svg{width:20px;height:20px}.ds-hudbtn:hover{background:#ffd400}.ds-hudbtn:focus-visible{outline:3px solid #ffd400;outline-offset:3px}"
    },
    {
      "name": "Pager",
      "kind": "custom",
      "refersTo": "pager",
      "description": "Black pager device with LED and sage LCD for mission messages.",
      "html": "<div class=\"ds-pager\"><span class=\"ds-brand\">PAGE</span><span class=\"ds-led\"></span><div class=\"ds-lcd\">Mama Volta: get to the docks</div></div>",
      "css": ".ds-pager{display:inline-flex;align-items:center;gap:10px;background:#0d0d0c;border-radius:14px;padding:8px 10px 8px 12px;box-shadow:0 8px 22px rgba(0,0,0,.45)}.ds-brand{font:italic 900 12px 'Archivo',sans-serif;color:#7d8188;writing-mode:vertical-rl;transform:rotate(180deg);letter-spacing:.08em}.ds-led{width:9px;height:9px;border-radius:50%;background:#ff4a32}.ds-lcd{background:#a9b59a;color:#1c2616;border-radius:6px;padding:7px 12px;font:700 19px/1.15 'Barlow Condensed',sans-serif;letter-spacing:.03em;text-transform:uppercase;box-shadow:inset 0 2px 4px rgba(0,0,0,.35)}"
    },
    {
      "name": "District Sign",
      "kind": "chip",
      "refersTo": "district-sign",
      "description": "Paper plate announcing the district entered.",
      "html": "<div class=\"ds-sign\">SOUTHEAST DOCKYARD</div>",
      "css": ".ds-sign{display:inline-block;background:#ece6d2;color:#14130f;border-radius:4px;padding:5px 12px;font:italic 800 15px 'Archivo',sans-serif;font-stretch:115%;letter-spacing:.14em;box-shadow:0 4px 12px rgba(0,0,0,.3)}"
    },
    {
      "name": "Keycap",
